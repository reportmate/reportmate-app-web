# ReportMate Web App Environment Configuration
# Copy this to .env.local and configure for your environment

# ReportMate API (FastAPI) base URL (REQUIRED - no Next.js API fallback)
API_BASE_URL=https://your-reportmate-api.example.com

# Shared secret sent to the API as X-Internal-Secret
API_INTERNAL_SECRET=

# Live events through Azure Web PubSub (optional - polling fallback available).
# The connection URL comes from the API's negotiate endpoint.
NEXT_PUBLIC_ENABLE_SIGNALR=true
